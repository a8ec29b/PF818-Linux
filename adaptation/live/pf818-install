def tr(key, **values):
    return TEXT[key][0 if LANG == 'zh' else 1].format(**values)


def say(key, **values):
    print(tr(key, **values), flush=True)


class InstallError(RuntimeError):
    def __init__(self, key):
        self.key = key
        super().__init__(key)


def run(args):
    return subprocess.check_output([str(a) for a in args], text=True).strip()


def select_language():
    print('PF818 Live\n1. 简体中文\n2. English\n0. 退出 / Exit', flush=True)
    while True:
        choice = input('语言 / Language [1]: ').strip() or '1'
        if choice in ('0', '1', '2'):
            return {'0': None, '1': 'zh', '2': 'en'}[choice]
        print('请输入 0、1 或 2 / Enter 0, 1 or 2.', flush=True)


def device_size(path):
    with path.open('rb', buffering=0) as device:
        return struct.unpack('Q', fcntl.ioctl(device.fileno(), 0x80081272, bytes(8)))[0]


def environment():
    if b'bozztek,pf818\0' not in COMPATIBLE.read_bytes():
        raise InstallError('board')
    root = Path(run(['findmnt', '-n', '-o', 'SOURCE', '/'])).resolve()
    parent = run(['lsblk', '-n', '-d', '-o', 'PKNAME', root])
    type_file = SYS_BLOCK / parent / 'device/type'
    if not parent or not type_file.is_file() or type_file.read_text().strip() != 'SD':
        raise InstallError('sd')
    candidates = [p for p in SYS_BLOCK.glob('mmcblk*') if re.fullmatch(r'mmcblk\d+', p.name)
                  and (p / 'device/type').is_file() and (p / 'device/type').read_text().strip() == 'MMC']
    if len(candidates) != 1:
        raise InstallError('target')
    target = Path('/dev') / candidates[0].name
    if target.name == parent or not stat.S_ISBLK(target.stat().st_mode):
        raise InstallError('target')
    if (candidates[0] / 'ro').read_text().strip() != '0':
        raise InstallError('target')
    return {'root': str(root), 'target': target, 'bytes': device_size(target)}


def payload(bundle, kind):
    try:
        manifest = json.loads((bundle / 'manifest.json').read_text())
        entry = manifest['images'][kind]
        path = (bundle / entry['file']).resolve()
        path.relative_to(bundle.resolve())
        if manifest['format'] != 1 or not path.is_file() or not entry['file'].endswith('.img.gz'):
            raise ValueError('file')
        if not isinstance(entry['bytes'], int) or entry['bytes'] <= 0:
            raise ValueError('length')
        if not re.fullmatch(r'[0-9a-f]{64}', entry['sha256']):
            raise ValueError('hash')
        return path, entry
    except (OSError, KeyError, TypeError, ValueError) as error:
        raise InstallError('manifest') from error


def validate_capacity(kind, size, image_bytes):
    if image_bytes <= 0 or size < image_bytes or (kind == 'android' and size != image_bytes):
        raise InstallError('size')


def target_devices(target):
    return {Path(p).resolve() for p in run(['lsblk', '-r', '-n', '-p', '-o', 'NAME', target]).splitlines()}


def source_is_separate(path, target):
    source = Path(run(['findmnt', '-n', '-o', 'SOURCE', '-T', path])).resolve()
    if source in target_devices(target):
        raise InstallError('source')


def progress(key, total):
    last = [0.0]

    def update(done):
        now = time.monotonic()
        if done == total or now - last[0] >= 1:
            print(f'\r{tr(key)}: {done * 100 / total:5.1f}%  '
                  f'{done / 1024**2:.0f}/{total / 1024**2:.0f} MiB', end='', flush=True)
            last[0] = now
            if done == total:
                print(flush=True)
    return update


def verify_archive(path, expected_size, expected_hash, report):
    digest, size = hashlib.sha256(), 0
    with gzip.open(path, 'rb') as source:
        while chunk := source.read(4 * 1024**2):
            size += len(chunk)
            if size > expected_size:
                raise InstallError('hash')
            digest.update(chunk)
            report(size)
    if size != expected_size or digest.hexdigest() != expected_hash:
        raise InstallError('hash')


def release_target(target):
    devices = target_devices(target)
    swaps = json.loads(run(['swapon', '--show', '--json', '--output', 'NAME']))
    for entry in swaps.get('swapdevices', []):
        swap = Path(entry['name'])
        backing = swap.resolve() if swap.is_block_device() else Path(
            run(['findmnt', '-n', '-o', 'SOURCE', '-T', swap])).resolve()
        if backing in devices:
            subprocess.run(['swapoff', str(swap)], check=True)
    mounts = json.loads(run(['findmnt', '--json', '--list', '--output', 'SOURCE,TARGET']))
    targets = [entry['target'] for entry in mounts.get('filesystems', [])
               if Path(entry['source']).resolve() in devices]
    for mount in sorted(set(targets), key=lambda p: len(Path(p).parts), reverse=True):
        subprocess.run(['umount', '--', mount], check=True)


def flash_archive(path, target, expected_size, expected_hash, write_report, read_report):
    # Linux O_EXCL prevents opening a block device that is still mounted/in use.
    fd = os.open(target, os.O_RDWR | os.O_EXCL)
    with os.fdopen(fd, 'r+b', buffering=0) as destination:
        digest, written = hashlib.sha256(), 0
        with gzip.open(path, 'rb') as source:
            while chunk := source.read(4 * 1024**2):
                if written + len(chunk) > expected_size:
                    raise InstallError('hash')
                view = memoryview(chunk)
                while view:
                    count = destination.write(view)
                    if not count:
                        raise OSError('Short device write')
                    view = view[count:]
                written += len(chunk)
                digest.update(chunk)
                write_report(written)
        os.fsync(destination.fileno())
        if written != expected_size or digest.hexdigest() != expected_hash:
            raise InstallError('hash')
        say('stage5')
        destination.seek(0)
        digest, read = hashlib.sha256(), 0
        while read < expected_size:
            chunk = destination.read(min(4 * 1024**2, expected_size - read))
            if not chunk:
                raise InstallError('readback')
            digest.update(chunk)
            read += len(chunk)
            read_report(read)
        if digest.hexdigest() != expected_hash:
            raise InstallError('readback')


def action(kind, bundle=BUNDLE):
    say('stage1')
    env = environment()
    image, entry = payload(bundle, kind)
    source_is_separate(image, env['target'])
    validate_capacity(kind, env['bytes'], entry['bytes'])
    say('environment', root=env['root'], target=env['target'], size=env['bytes'] / 1024**3, action=tr(kind))
    say('image', file=image, size=entry['bytes'])
    say('stage2')
    verify_archive(image, entry['bytes'], entry['sha256'], progress('verify', entry['bytes']))
    say('stage3')
    say('erase')
    token = f'{"INSTALL" if kind == "linux" else "RESTORE"} {env["target"]}'
    if input(tr('confirmation', token=token)).strip() != token:
        say('cancelled')
        return False
    if environment() != env:
        raise InstallError('changed')
    say('stage4')
    logging.info('Start %s target=%s image=%s bytes=%s sha256=%s',
                 kind, env['target'], image, entry['bytes'], entry['sha256'])
    release_target(env['target'])
    flash_archive(image, env['target'], entry['bytes'], entry['sha256'],
                  progress('write', entry['bytes']), progress('read', entry['bytes']))
    logging.info('Completed %s; readback passed', kind)
    say('done')
    say('next_' + kind)
    return True


def main():
    global LANG
    LANG = select_language()
    if LANG is None:
        return 0
    say('title')
    if not sys.platform.startswith('linux'):
        say('platform')
        return 1
    if os.geteuid() != 0:
        say('root')
        return 1
    logging.basicConfig(filename='/var/log/pf818-install.log', level=logging.INFO,
                        format='%(asctime)s %(levelname)s %(message)s')
    while True:
        say('menu')
        choice = input(tr('choice')).strip()
        if choice == '0':
            return 0
        if choice not in ('1', '2'):
            say('invalid')
            continue
        try:
            if action('linux' if choice == '1' else 'android'):
                if input(tr('poweroff')).strip() == '1':
                    subprocess.run(['systemctl', 'poweroff'], check=True)
                    return 0
        except KeyboardInterrupt:
            print()
            say('interrupted')
            logging.warning('Operation interrupted by user')
        except (InstallError, OSError, EOFError, ValueError, subprocess.SubprocessError) as error:
            print()
            message = tr(error.key) if isinstance(error, InstallError) else str(error)
            say('failed', error=message)
            logging.exception('Installation failed')


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print()
        sys.exit(130)
