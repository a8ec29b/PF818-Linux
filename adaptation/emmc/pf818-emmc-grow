#!/bin/bash
set -eu

rootdev=$(readlink -f "$(findmnt -n -o SOURCE /)")
parent=$(lsblk -ndo PKNAME "$rootdev")
if [[ $(cat "/sys/class/block/$parent/device/type") != MMC ]]; then
    echo 'Root is not on eMMC; leave the medium unchanged.'
    exit 0
fi

partname=$(basename "$rootdev")
[[ $(cat "/sys/class/block/$partname/partition") == 2 ]]
[[ $(findmnt -n -o UUID /) == '@ROOT_UUID@' ]]
diskdev="/dev/$parent"

echo "Expand GPT partition 2 and ext4 on $diskdev"
sfdisk --no-reread --no-tell-kernel --relocate gpt-bak-std "$diskdev"
printf ', +\n' | sfdisk --no-reread --no-tell-kernel \
    --wipe never --wipe-partitions never -N 2 "$diskdev"
partx --update --nr 2 "$diskdev"
udevadm settle
resize2fs "$rootdev"
date --iso-8601=seconds > /var/lib/pf818/emmc-expanded
echo 'eMMC root filesystem expansion completed.'
